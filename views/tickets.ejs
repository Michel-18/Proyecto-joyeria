<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Tickets</title>

<style>
body {
  background: #faf4f7;
  font-family: monospace;
}

.ticket {
  max-width: 320px;
  margin: 40px auto;
  background: white;
  padding: 20px;
  border: 1px dashed #333;
}

h1 {
  text-align: center;
}

.total {
  text-align: right;
  font-weight: bold;
}
</style>
</head>

<body>

<div class="ticket">
<h1>🧾 Jewelry Girl</h1>
<p><%= ticket.detalle %></p>
<hr>
<p class="total">Total: $<%= ticket.total %></p>
</div>

<a href="/inicio">← Inicio</a>

</body>
</html>
