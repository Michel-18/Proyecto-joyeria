<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Mis compras | Jewelry Girl</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #faf4f7;
      padding: 30px;
    }

    h1 {
      text-align: center;
      color: #c2185b;
      margin-bottom: 30px;
    }

    .ticket {
      max-width: 420px;
      margin: 20px auto;
      background: white;
      padding: 20px;
      border-radius: 14px;
      box-shadow: 0 8px 18px rgba(0,0,0,.1);
    }

    .fecha {
      font-size: 14px;
      color: #666;
      margin-bottom: 10px;
    }

    .total {
      font-weight: bold;
      color: #e91e63;
      text-align: right;
      font-size: 1.1rem;
    }

    .acciones {
      display: flex;
      justify-content: space-between;
      margin-top: 15px;
    }

    button {
      border: none;
      padding: 8px 14px;
      border-radius: 20px;
      cursor: pointer;
      font-size: 14px;
    }

    .eliminar {
      background: #ff7f7f;
      color: white;
    }

    .volver {
      display: block;
      text-align: center;
      margin-top: 30px;
      font-weight: bold;
      color: #c2185b;
      text-decoration: none;
    }
  </style>
</head>

<body>

<h1>🧾 Mis compras</h1>

<% if (!ventas || ventas.length === 0) { %>
  <p style="text-align:center;">Aún no tienes compras registradas</p>
<% } %>

<% ventas.forEach(venta => { %>
  <div class="ticket">

    <!-- FECHA FORMATEADA -->
    <p class="fecha">
      <strong>Fecha:</strong>
      <%= new Date(venta.fecha).toLocaleDateString('es-MX', {
        day: '2-digit',
        month: 'long',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      }) %>
    </p>

    <hr>

    <p class="total">
      Total: $<%= Number(venta.total).toFixed(2) %>
    </p>

    <div class="acciones">
      <!-- ELIMINAR REGISTRO -->
      <form action="/tickets/eliminar/<%= venta.id %>" method="POST">
        <button class="eliminar">🗑 Eliminar</button>
      </form>
    </div>
  </div>
<% }) %>

<a href="/inicio" class="volver">← Volver a la tienda</a>

</body>
</html>
