<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Mis Tickets | Jewelry Girl</title>

  <style>
    body {
      background: #f2f2f2;
      font-family: 'Courier New', monospace;
      padding: 20px;
    }

    h1 {
      text-align: center;
      margin-bottom: 25px;
    }

    .tickets-container {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      justify-content: center;
    }

    .ticket {
      background: #fff;
      width: 320px;
      padding: 15px;
      border: 1px dashed #333;
    }

    .line {
      border-top: 1px dashed #000;
      margin: 10px 0;
    }

    .detalle {
      font-size: 14px;
      margin-bottom: 8px;
      white-space: pre-line;
    }

    .total {
      font-weight: bold;
      font-size: 16px;
      text-align: right;
    }

    .fecha {
      font-size: 12px;
      text-align: center;
      color: #666;
      margin-top: 8px;
    }

    .volver {
      display: block;
      text-align: center;
      margin-top: 30px;
      text-decoration: none;
      font-weight: bold;
      color: #c2185b;
    }

    .empty {
      text-align: center;
      color: #777;
      font-size: 1.1rem;
    }
  </style>
</head>
<body>

<h1>🧾 Mis Tickets - Jewelry Girl</h1>

<% if (!tickets || tickets.length === 0) { %>
  <p class="empty">No tienes tickets registrados</p>
<% } else { %>

  <div class="tickets-container">
    <% tickets.forEach(ticket => { %>
      <div class="ticket">

        <h3 style="text-align:center;">💎 Jewelry Girl</h3>

        <div class="line"></div>

        <div class="detalle">
          <%= ticket.detalle %>
        </div>

        <div class="line"></div>

        <div class="total">
          Total: $<%= ticket.total %>
        </div>

        <div class="fecha">
          <%= new Date(ticket.fecha).toLocaleString() %>
        </div>

      </div>
    <% }) %>
  </div>

<% } %>

<a href="/inicio" class="volver">⬅ Volver al inicio</a>

</body>
</html>
