<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= titulo %></title>
  <style>
    body {
      background: #f2f2f2;
      font-family: 'Courier New', monospace;
      padding: 20px;
    }

    .ticket {
      background: #fff;
      width: 320px;
      margin: auto;
      padding: 15px;
      border: 1px dashed #333;
    }

    h1 {
      text-align: center;
      margin-bottom: 10px;
    }

    .line {
      border-top: 1px dashed #000;
      margin: 10px 0;
    }

    .detalle {
      font-size: 14px;
      margin-bottom: 8px;
    }

    .total {
      font-weight: bold;
      font-size: 16px;
      text-align: right;
    }

    a {
      display: block;
      text-align: center;
      margin-top: 15px;
      text-decoration: none;
      font-weight: bold;
      color: #c2185b;
    }
  </style>
</head>
<body>

<div class="ticket">
  <h1>🧾 Jewelry Girl</h1>

  <div class="line"></div>

  <div class="detalle">
    <%= ticket.detalle %>
  </div>

  <div class="line"></div>

  <div class="total">
    Total: $<%= ticket.total %>
  </div>
</div>

<a href="/tickets">⬅ Volver a mis tickets</a>

</body>
</html>
