<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Nuevo Producto</title>

  <style>
    body {
      background: #fef6f7;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      margin: 0;
      padding: 30px;
    }

    h2 {
      text-align: center;
      color: #b96b87;
      margin-bottom: 25px;
    }

    .contenedor {
      max-width: 500px;
      margin: auto;
      background: #fff;
      padding: 30px;
      border-radius: 14px;
      box-shadow: 0 8px 20px rgba(0,0,0,.1);
    }

    label {
      font-weight: bold;
      color: #805366;
      display: block;
      margin-top: 15px;
      margin-bottom: 5px;
    }

    input, textarea {
      width: 100%;
      padding: 10px;
      border-radius: 8px;
      border: 1px solid #ddd;
      font-size: 15px;
      resize: none;
    }

    textarea {
      height: 80px;
    }

    button {
      margin-top: 25px;
      width: 100%;
      background: #e91e63;
      color: white;
      border: none;
      padding: 12px;
      border-radius: 8px;
      font-size: 16px;
      cursor: pointer;
      font-weight: bold;
    }

    button:hover {
      background: #c2185b;
    }

    .volver {
      display: block;
      text-align: center;
      margin-top: 20px;
      text-decoration: none;
      color: #c2185b;
      font-weight: bold;
    }
  </style>
</head>

<body>

  <div class="contenedor">
    <h2>➕ Nuevo producto</h2>

    <form method="POST" action="/admin/productos">

      <label>Nombre del producto</label>
      <input name="nombre" placeholder="Ej. Collar de plata" required>

      <label>Descripción</label>
      <textarea name="descripcion" placeholder="Descripción del producto"></textarea>

      <label>Precio</label>
      <input name="precio" type="number" step="0.01" placeholder="0.00" required>

      <label>Imagen (URL)</label>
      <input name="imagen" placeholder="https://imagen.com/producto.jpg">

      <button type="submit">Guardar producto</button>
    </form>

    <a href="/admin" class="volver">⬅ Volver al panel</a>
  </div>

</body>
</html>
