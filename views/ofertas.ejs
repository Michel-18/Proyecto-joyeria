<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Ofertas | Jewelry Girl</title>

  <link rel="stylesheet" href="/css/ofertas.css">
</head>
<body>

<header>
  <h1>💎 Ofertas Jewelry Girl 💎</h1>
  <nav>
    <a href="/inicio" class="btn-azul">⬅ Volver al inicio</a>
    <a href="/consulta" class="btn-azul">🛍️ Ver carrito</a>
  </nav>
</header>

<main>
  <section class="productos">
    <h2>Promociones de la semana</h2>

    <div class="grid">

      <!-- PRODUCTO 1 -->
      <div class="producto">
        <img src="/images/aretes.svg" alt="Aretes en oferta">

        <p><strong>Aretes en oferta</strong></p>
        <p>Antes: <del>$50</del> | <strong>Ahora: $35</strong></p>

        <!-- ID REAL DE PRODUCTO -->
        <a href="/carrito/agregar/1" class="btn-carrito">
          🛒 Añadir al carrito
        </a>
      </div>

      <!-- PRODUCTO 2 -->
      <div class="producto">
        <img src="/images/collar.svg" alt="Collar en oferta">

        <p><strong>Collar en oferta</strong></p>
        <p>Antes: <del>$80</del> | <strong>Ahora: $60</strong></p>

        <!-- ID REAL DE PRODUCTO -->
        <a href="/carrito/agregar/2" class="btn-carrito">
          🛒 Añadir al carrito
        </a>
      </div>

    </div>
  </section>
</main>

</body>
</html>
