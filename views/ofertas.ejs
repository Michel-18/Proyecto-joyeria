<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %></title>
  <link rel="stylesheet" href="/css/ofertas.css">
</head>
<body>

<header>
  <h1>💎 Ofertas Jewelry Girl 💎</h1>
  <nav>
    <a href="/inicio" class="btn-azul">Volver al inicio</a>
    <a href="/consulta" class="btn-azul">🛍️ Ver carrito</a>
  </nav>
</header>

<main>
  <section class="productos">
    <h2>Promociones de la semana</h2>

    <div class="grid">

      <!-- PRODUCTO 1 -->
      <div class="producto">
        <img src="/images/aretes.svg" alt="Aretes">
        <p><strong>Aretes en oferta</strong></p>
        <p>Antes: <del>$50</del> | Ahora: $35</p>

        <a
          href="/carrito/agregar?nombre=Aretes en oferta&precio=35<%= reemplazar ? '&reemplazar=' + reemplazar : '' %>">
          <button class="btn-carrito">
            <%= reemplazar ? '🔄 Cambiar por este' : '🛒 Añadir' %>
          </button>
        </a>
      </div>

      <!-- PRODUCTO 2 -->
      <div class="producto">
        <img src="/images/collar.svg" alt="Collar">
        <p><strong>Collar en oferta</strong></p>
        <p>Antes: <del>$80</del> | Ahora: $60</p>

        <a
          href="/carrito/agregar?nombre=Collar en oferta&precio=60<%= reemplazar ? '&reemplazar=' + reemplazar : '' %>">
          <button class="btn-carrito">
            <%= reemplazar ? '🔄 Cambiar por este' : '🛒 Añadir' %>
          </button>
        </a>
      </div>

    </div>
  </section>
</main>

</body>
</html>
