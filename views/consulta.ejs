<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Tu carrito</title>
<style>
body {
  background:#fef6f7;
  font-family:Segoe UI;
  padding:20px;
}
.contenedor {
  max-width:700px;
  margin:auto;
  background:#fff0f5;
  padding:30px;
  border-radius:12px;
}
.item {
  background:#fde8f0;
  padding:12px;
  margin-bottom:10px;
  border-radius:8px;
  display:flex;
  justify-content:space-between;
}
button {
  border:none;
  padding:6px 10px;
  border-radius:6px;
  cursor:pointer;
}
.editar { background:#d36a94; color:white; }
.eliminar { background:#ff7f7f; color:white; }
.total {
  text-align:right;
  font-weight:bold;
  margin-top:20px;
}
a { text-decoration:none; }
</style>
</head>
<body>

<div class="contenedor">
<h1>🛍️ Tu carrito</h1>

<% if (carrito.length === 0) { %>
  <p>Tu carrito está vacío</p>
<% } else { %>

  <% carrito.forEach(item => { %>
    <div class="item">
      <span><%= item.nombre %> - $<%= item.precio %></span>
      <div>
        <a href="/ofertas?reemplazar=<%= item.id %>">
          <button class="editar">🔄 Cambiar</button>
        </a>
        <form action="/consulta/eliminar/<%= item.id %>" method="POST" style="display:inline">
          <button class="eliminar">🗑️</button>
        </form>
      </div>
    </div>
  <% }) %>

  <div class="total">
    Total: $
    <%= carrito.reduce((s,p)=>s+p.precio,0) %>
  </div>

<% } %>

<br>
<a href="/ofertas">← Seguir comprando</a>
</div>

</body>
</html>
