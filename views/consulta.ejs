<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Carrito | Jewelry Girl</title>

<style>
body {
  background: #faf4f7;
  font-family: 'Inter', sans-serif;
}

.contenedor {
  max-width: 700px;
  margin: 40px auto;
  background: white;
  padding: 30px;
  border-radius: 16px;
  box-shadow: 0 8px 18px rgba(0,0,0,.1);
}

h1 {
  text-align: center;
  color: #c2185b;
}

.item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff0f5;
  padding: 12px;
  border-radius: 10px;
  margin-bottom: 10px;
}

button {
  border: none;
  padding: 8px 14px;
  border-radius: 20px;
  background: #ff7f7f;
  color: white;
  cursor: pointer;
}

.total {
  text-align: right;
  font-size: 1.3rem;
  font-weight: bold;
  margin-top: 20px;
}

.comprar {
  width: 100%;
  background: #d36a94;
  padding: 12px;
  border-radius: 25px;
  font-size: 1rem;
  margin-top: 15px;
}

a {
  display: block;
  text-align: center;
  margin-top: 20px;
  color: #c2185b;
  font-weight: bold;
  text-decoration: none;
}
</style>
</head>

<body>

<div class="contenedor">
<h1>🛍️ Tu carrito</h1>

<% if (!carrito || carrito.length === 0) { %>
  <p style="text-align:center">Tu carrito está vacío</p>
<% } else { %>

  <% const total = carrito.reduce((s, p) => s + Number(p.precio), 0); %>

  <% carrito.forEach(item => { %>
    <div class="item">
      <span><strong><%= item.nombre %></strong> — $<%= item.precio %></span>
      <form action="/consulta/eliminar/<%= item.id %>" method="POST">
        <button>🗑️</button>
      </form>
    </div>
  <% }) %>

  <div class="total">Total: $<%= total %></div>

  <form action="/comprar" method="POST">
    <button class="comprar">💳 Comprar</button>
  </form>

<% } %>

<a href="/inicio">← Seguir comprando</a>
</div>

</body>
</html>
