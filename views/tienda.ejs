<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= titulo %></title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #faf4f7;
      margin: 0; padding: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
    }
    h1 {
      margin-top: 30px;
      color: #b96b87;
    }
    #map {
      margin-top: 20px;
      width: 90%;
      max-width: 600px;
      height: 400px;
      border-radius: 15px;
      box-shadow: 0 0 15px rgba(185, 102, 131, 0.3);
    }
    .direccion {
      margin-top: 15px;
      font-size: 1.1rem;
      color: #805366;
    }
  </style>
</head>
<body>

  <h1>Tienda Física Jewelry Girl 💎</h1>

  <!-- Mapa embebido de Google Maps -->
  <iframe
    id="map"
    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3763.998252346449!2d-99.1887431845859!3d19.423094986720217!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x85d1ff53e54e4c33%3A0x17227e42825a99a7!2sCentro%20Hist%C3%B3rico%2C%20Cd.%20de%20M%C3%A9xico%2C%20CDMX!5e0!3m2!1ses!2smx!4v1673175302245!5m2!1ses!2smx"
    style="border:0;"
    allowfullscreen=""
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>

  <p class="direccion">
    📍 Dirección: Centro Histórico, Ciudad de México
  </p>

</body>
</html>
