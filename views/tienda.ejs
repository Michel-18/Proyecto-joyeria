<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Tienda | Jewelry Girl</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Dancing+Script:wght@700&display=swap" rel="stylesheet">

<style>
body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background: #faf4f7;
}

header {
  background: #d36a94;
  padding: 20px;
  color: white;
  text-align: center;
}

header h1 {
  font-family: 'Dancing Script', cursive;
  font-size: 3rem;
  margin: 0;
}

nav a {
  color: white;
  margin: 0 12px;
  text-decoration: none;
  font-weight: 600;
}

.productos {
  max-width: 1100px;
  margin: 40px auto;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 25px;
}

.card {
  background: white;
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 8px 18px rgba(0,0,0,.1);
  text-align: center;
}

.card img {
  width: 100%;
  height: 180px;
  object-fit: cover;
  border-radius: 12px;
}

.precio {
  font-size: 1.2rem;
  font-weight: bold;
  color: #e91e63;
  margin: 10px 0;
}

.btn {
  display: inline-block;
  background: #d36a94;
  color: white;
  padding: 10px 22px;
  border-radius: 20px;
  text-decoration: none;
  font-weight: 600;
}
</style>
</head>

<body>

<header>
  <h1>Jewelry Girl 💎</h1>
  <nav>
    <a href="/consulta">Carrito</a>
    <a href="/tickets">Mis compras</a>
    <a href="/logout">Salir</a>
  </nav>
</header>

<section class="productos">

  <% if (productos && productos.length > 0) { %>

    <% productos.forEach(p => { %>
      <div class="card">

        <!-- Imagen con respaldo -->
        <img 
          src="<%= p.imagen && p.imagen.trim() !== '' ? p.imagen : '/images/default.jpg' %>" 
          alt="<%= p.nombre %>"
          onerror="this.src='/images/default.jpg'"
        >

        <h3><%= p.nombre %></h3>

        <p><%= p.descripcion || '' %></p>

        <div class="precio">
          $<%= Number(p.precio || 0).toFixed(2) %>
        </div>

        <a href="/carrito/agregar/<%= p.id %>" class="btn">
          🛒 Agregar
        </a>
      </div>
    <% }) %>

  <% } else { %>

    <p style="text-align:center; font-size:1.2rem;">
      No hay productos disponibles.
    </p>

  <% } %>

</section>

</body>
</html>
