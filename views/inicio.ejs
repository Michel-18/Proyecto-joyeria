<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= titulo %></title>
  <link rel="stylesheet" href="/css/inicio.css" />
</head>

<body>
  <header>
    <h1>Jewelry Girl 💎</h1>
    <nav>
      <button>Cerrar sesión</button>
      <button>Eliminar cuenta</button>
    </nav>
  </header>

  <main>
    <aside>
      <ul class="menu-lateral">
        <li><a href="/ofertas" class="btn-menu">Ofertas</a></li>
        <li><a href="/tienda" class="btn-menu">Tienda F.</a></li>
        <li><a href="/consulta" class="btn-menu">Consulta</a></li>
      </ul>
    </aside>

    <section class="productos">
      <h2>Toda, aretes, collares, anillos y pulseras</h2>

      <div class="grid">

        <!-- Producto 1 -->
        <div class="producto">
          <img src="/images/aretes.svg" alt="Aretes" />
          <p><strong>Producto:</strong> Aretes</p> 
          <p>Material: Acero</p>
          <p>Precio: $50</p>

          <form action="/agregar-carrito" method="POST">
            <input type="hidden" name="nombre" value="Aretes" />
            <input type="hidden" name="precio" value="50" />
            <button type="submit">🛒 Añadir</button>
          </form>
        </div>

        <!-- Producto 2 -->
        <div class="producto">
          <img src="/images/collar.svg" alt="Collar" />
          <p><strong>Producto:</strong> Collar</p>
          <p>Material: Oro</p>
          <p>Precio: $50</p>

          <form action="/agregar-carrito" method="POST">
            <input type="hidden" name="nombre" value="Collar" />
            <input type="hidden" name="precio" value="50" />
            <button type="submit">🛒 Añadir</button>
          </form>
        </div>

        <!-- Producto 3 -->
        <div class="producto">
          <img src="/images/anillo.svg" alt="Anillo" />
          <p><strong>Producto:</strong> Anillo</p>
          <p>Material: Plata</p>
          <p>Precio: $20</p>

          <form action="/agregar-carrito" method="POST">
            <input type="hidden" name="nombre" value="Anillo" />
            <input type="hidden" name="precio" value="20" />
            <button type="submit">🛒 Añadir</button>
          </form>
        </div>

        <!-- Producto 4 -->
        <div class="producto">
          <img src="/images/pulsera.svg" alt="Pulsera" />
          <p><strong>Producto:</strong> Pulsera</p>
          <p>Material: Chapa de oro</p>
          <p>Precio: $20</p>

          <form action="/agregar-carrito" method="POST">
            <input type="hidden" name="nombre" value="Pulsera" />
            <input type="hidden" name="precio" value="20" />
            <button type="submit">🛒 Añadir</button>
          </form>
        </div>

      </div>
    </section>
  </main>
</body>
</html>
