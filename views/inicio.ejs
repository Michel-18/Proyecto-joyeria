<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Tienda | Jewelry Girl</title>

  <style>
    body {
      font-family: Arial;
      background: #faf4f7;
      padding: 30px;
    }

    h1 {
      text-align: center;
      color: #c2185b;
    }

    .productos {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 25px;
      max-width: 1200px;
      margin: auto;
    }

    .card {
      background: #fff;
      padding: 20px;
      border-radius: 15px;
      text-align: center;
      box-shadow: 0 8px 20px rgba(0,0,0,.1);
    }

    img {
      width: 100%;
      height: 180px;
      object-fit: cover;
      border-radius: 10px;
      margin-bottom: 10px;
    }

    .precio {
      color: #e91e63;
      font-weight: bold;
    }
  </style>
</head>
<body>

<h1>Nuestra Tienda 💎</h1>

<div class="productos">
  <% productos.forEach(p => { %>

    <div class="card">

          <% if (p.imagen && p.imagen.includes('/')) { %>
            <img 
              src="<%= p.imagen %>" 
              alt="Producto <%= p.nombre %>" 
              loading="lazy"
            >
          <% } else if (p.imagen) { %>
            <img 
              src="/images/<%= p.imagen %>" 
              alt="Producto <%= p.nombre %>" 
              loading="lazy"
            >
          <% } else { %>
            <img 
              src="https://via.placeholder.com/300x180?text=<%= p.nombre %>" 
              alt="Producto sin imagen" 
              loading="lazy"
            >
          <% } %>
