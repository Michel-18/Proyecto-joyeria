<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= titulo %></title>

  <style>
    body {
      background:#fef6f7;
      font-family:Segoe UI, sans-serif;
      padding:20px;
    }
    .contenedor {
      max-width:500px;
      margin:auto;
      background:#fff;
      padding:25px;
      border-radius:12px;
      box-shadow:0 8px 20px rgba(0,0,0,.1);
    }
    h2 { text-align:center; color:#b96b87; }
    .total {
      font-size:18px;
      font-weight:bold;
      margin:15px 0;
      text-align:center;
    }
    .producto {
      font-size:14px;
      border-bottom:1px solid #eee;
      padding:5px 0;
    }
    input, button {
      width:100%;
      padding:10px;
      margin-top:10px;
    }
    button {
      background:#e91e63;
      color:white;
      border:none;
      border-radius:6px;
      cursor:pointer;
      font-size:16px;
    }
    .cancelar {
      background:#aaa;
      margin-top:5px;
    }
  </style>
</head>
<body>

<div class="contenedor">
  <h2>Pago con tarjeta 💳</h2>

  <% carrito.forEach(p => { %>
    <div class="producto">
      <%= p.nombre %> — $<%= p.precio %>
    </div>
  <% }) %>

  <p class="total">Total: $<%= total %></p>

  <form method="POST" action="/pagotarjeta">
    <input type="text" name="nombre" placeholder="Nombre del titular" required>
    <input type="text" name="numero" placeholder="Número de tarjeta" required>

    <button type="submit">Confirmar pago</button>
  </form>

  <form action="/consulta">
    <button type="submit" class="cancelar">Cancelar</button>
  </form>
</div>

</body>
</html>
